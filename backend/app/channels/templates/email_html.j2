<!doctype html>
<html>
  <body style="font-family: sans-serif; color: #1a1a1a;">
    <table cellpadding="4" cellspacing="0" style="border-collapse: collapse; margin-top: 12px;">
      <tr><td style="font-weight: bold;">Cluster</td><td>{{ cluster }}</td></tr>
      <tr><td style="font-weight: bold;">Namespace</td><td>{{ namespace or "-" }}</td></tr>
      <tr><td style="font-weight: bold;">Team</td><td>{{ team }}</td></tr>
      <tr><td style="font-weight: bold;">Starts At</td><td>{{ starts_at | datetime_format }}</td></tr>
      {% if ends_at %}
      <tr><td style="font-weight: bold;">Ends At</td><td>{{ ends_at | datetime_format }}</td></tr>
      {% endif %}
    </table>

    <h3>Labels</h3>
    <table cellpadding="4" cellspacing="0" style="border-collapse: collapse; border: 1px solid #ddd;">
      {% for key, value in labels.items() %}
      <tr>
        <td style="border: 1px solid #ddd; font-weight: bold;">{{ key }}</td>
        <td style="border: 1px solid #ddd;">{{ value }}</td>
      </tr>
      {% endfor %}
    </table>

    <h3>Annotations</h3>
    <table cellpadding="4" cellspacing="0" style="border-collapse: collapse; border: 1px solid #ddd;">
      {% for key, value in annotations.items() %}
      <tr>
        <td style="border: 1px solid #ddd; font-weight: bold;">{{ key }}</td>
        <td style="border: 1px solid #ddd;">{{ value }}</td>
      </tr>
      {% endfor %}
    </table>

    <p>
      {% if runbook_url %}<a href="{{ runbook_url }}">Runbook</a>{% endif %}
      {% if runbook_url and grafana_url %} &middot; {% endif %}
      {% if grafana_url %}<a href="{{ grafana_url }}">Grafana</a>{% endif %}
      {% if app_url %}
        {% if runbook_url or grafana_url %} &middot; {% endif %}
        <a href="{{ app_url }}">View in app</a>
      {% endif %}
    </p>
  </body>
</html>
